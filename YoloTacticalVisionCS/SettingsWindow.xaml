<Window x:Class="YoloTacticalVisionCS.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARC Raiders // YOLO Tactical Vision Control Panel [C# DirectML]"
        Width="580" Height="780"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#0E1116"
        Foreground="#DDE2E8"
        FontFamily="Segoe UI, Arial"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#00FFCC"/>
            <Setter Property="BorderBrush" Value="#232936"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A202C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2F394C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDE2E8"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#161B24"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D3647"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18">
            <!-- Header -->
            <TextBlock Text="ARC RAIDERS // YOLO TACTICAL VISION [C# .NET 8]"
                       FontSize="16" FontWeight="Bold" Foreground="#00FFCC" FontFamily="Consolas"/>
            <TextBlock x:Name="TxtHardware" Text="Hardware: NVIDIA RTX 4060 (DirectML GPU) | 0.0 FPS"
                       FontSize="11" Foreground="#FF8800" FontFamily="Consolas" Margin="0,3,0,10"/>

            <!-- 1-Click Game Profiles -->
            <GroupBox Header="🎮 1-Klick Game-Profile (Auto-Tuning &amp; Model Swap)">
                <StackPanel>
                    <TextBlock Text="Wähle dein Spiel für sofortige Optimierung von Modell &amp; Scan-Zone:"
                               FontSize="11" Foreground="#8C9BAE" Margin="0,0,0,8"/>
                    <UniformGrid Columns="3">
                        <Button x:Name="BtnProfVal" Content="🎯 Valorant (150 FPS)" Margin="2"
                                Background="#2D142C" BorderBrush="#FF4655" Foreground="#FF4655" Click="BtnProfVal_Click"/>
                        <Button x:Name="BtnProfCs2" Content="🔫 CS2 (250 FPS)" Margin="2"
                                Background="#1A2735" BorderBrush="#E5A93C" Foreground="#E5A93C" Click="BtnProfCs2_Click"/>
                        <Button x:Name="BtnProfArc" Content="🤖 ARC Raiders (120 FPS)" Margin="2"
                                Background="#122824" BorderBrush="#00FFCC" Foreground="#00FFCC" Click="BtnProfArc_Click"/>
                    </UniformGrid>
                </StackPanel>
            </GroupBox>

            <!-- Model & Scan Region -->
            <GroupBox Header="🤖 Detection Model &amp; Region">
                <StackPanel>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ONNX Model:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbModel" Grid.Column="1" SelectionChanged="CmbModel_SelectionChanged"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Scan Region:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbRegion" Grid.Column="1" SelectionChanged="CmbRegion_SelectionChanged">
                            <ComboBoxItem Content="Center 480x480 (Ultra Low Latency ~150-250 FPS)"/>
                            <ComboBoxItem Content="Center 640x640 (Balanced Combat FOV ~120-170 FPS)"/>
                            <ComboBoxItem Content="Fullscreen (Full Screen Coverage)"/>
                        </ComboBox>
                    </Grid>

                    <TextBlock x:Name="LblConf" Text="Confidence Threshold: 50%" Margin="0,8,0,2"/>
                    <Slider x:Name="SldConf" Minimum="10" Maximum="90" Value="50" ValueChanged="SldConf_ValueChanged"/>
                </StackPanel>
            </GroupBox>

            <!-- Visual Overlay & Precision -->
            <GroupBox Header="🎯 Tactical HUD &amp; Visuals">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <CheckBox x:Name="ChkHeadMarker" Content="👑 Headshot Precision Reticle" IsChecked="True" Click="OnVisualChanged"/>
                        <CheckBox x:Name="ChkStance" Content="📐 Stance Detection (Crouch Head)" IsChecked="True" Click="OnVisualChanged"/>
                        <CheckBox x:Name="ChkLatComp" Content="⚡ Sub-Frame Lead (Latency Comp)" IsChecked="True" Click="OnVisualChanged"/>
                        <CheckBox x:Name="ChkClosest" Content="Highlight Closest Enemy" IsChecked="True" Click="OnVisualChanged"/>
                        <CheckBox x:Name="ChkZone" Content="Show Scan Zone Boundary" IsChecked="True" Click="OnVisualChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="ChkSmoothing" Content="🛡️ Anti-Jitter Box Smoothing" IsChecked="True" Click="OnVisualChanged"/>
                        <CheckBox x:Name="ChkAdaptive" Content="🌊 Adaptive One-Euro Filter" IsChecked="True" Click="OnVisualChanged"/>
                        <CheckBox x:Name="ChkCrosshair" Content="Show Center Crosshair" IsChecked="True" Click="OnVisualChanged"/>
                        <CheckBox x:Name="ChkSnaplines" Content="Tracer Laser Snapline" IsChecked="True" Click="OnVisualChanged"/>
                        <CheckBox x:Name="ChkStats" Content="Show Diagnostics (FPS/ms)" IsChecked="True" Click="OnVisualChanged"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Hotkeys & Actions -->
            <GroupBox Header="⌨️ Hotkeys &amp; Control">
                <StackPanel>
                    <TextBlock Text="• [F7] Toggle YOLO Overlay (Show / Hide)&#x0a;• [F8] Toggle Settings Window"
                               Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2">
                        <Button x:Name="BtnToggleOverlay" Content="👁️ Toggle Overlay (F7)" Click="BtnToggleOverlay_Click" Margin="2"/>
                        <Button x:Name="BtnReset" Content="↺ Reset to Defaults" Click="BtnReset_Click" Margin="2"/>
                    </UniformGrid>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
